# 复制为 .env 后按需修改；所有变量都有默认值，可以只写需要覆盖的项

# 云端 Agent 的 WebSocket 地址
HOMEPILOT_SERVER_URL=ws://127.0.0.1:8000/ws/voice/
# 本设备的唯一标识
HOMEPILOT_DEVICE_ID=homepilot-dev
# 云端认证令牌，留空表示不认证
HOMEPILOT_AUTH_TOKEN=
# 断线重连等待（秒）：从 MIN 开始翻倍，最长 MAX，带 ±20% 抖动
HOMEPILOT_RECONNECT_MIN_S=1
HOMEPILOT_RECONNECT_MAX_S=30
# WebSocket 心跳间隔（秒），同时作为心跳超时
HOMEPILOT_PING_INTERVAL_S=20

# 音频设备：留空使用系统默认，可填设备索引（如 3）或名称子串（如 麦克风）
HOMEPILOT_INPUT_DEVICE=
HOMEPILOT_OUTPUT_DEVICE=
# 优先使用的 Windows Host API：wasapi / mme / directsound
HOMEPILOT_AUDIO_HOSTAPI=wasapi
# 音频分片时长，只能是 20 或 40（毫秒）
HOMEPILOT_FRAME_MS=20

# 唤醒词模型（sherpa-onnx KWS），下载方式见 README；以下文件名相对于 KWS_MODEL_DIR
HOMEPILOT_KWS_MODEL_DIR=models/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01
HOMEPILOT_KWS_ENCODER=encoder-epoch-12-avg-2-chunk-16-left-64.int8.onnx
HOMEPILOT_KWS_DECODER=decoder-epoch-12-avg-2-chunk-16-left-64.onnx
HOMEPILOT_KWS_JOINER=joiner-epoch-12-avg-2-chunk-16-left-64.int8.onnx
HOMEPILOT_KWS_TOKENS=tokens.txt
# 关键词文件（仓库自带「你好小余」）
HOMEPILOT_KWS_KEYWORDS_FILE=keywords.txt
# 越大越容易触发
HOMEPILOT_KWS_KEYWORDS_SCORE=1.0
# 0~1，越大越难触发（误唤醒多时调高，漏检多时调低）
HOMEPILOT_KWS_KEYWORDS_THRESHOLD=0.25
HOMEPILOT_KWS_NUM_THREADS=1

# 语音活动检测（sherpa-onnx Silero VAD），下载方式见 README
HOMEPILOT_VAD_MODEL=models/silero_vad.onnx
# 0~1，语音概率阈值；越大越不容易判定为语音（噪声误触发多时调高）
HOMEPILOT_VAD_THRESHOLD=0.5
# 连续语音达到该时长（毫秒）才判定开始，过滤咳嗽、敲击等短噪声
HOMEPILOT_VAD_MIN_SPEECH_MS=250
# 静音持续该时长（毫秒）才判定结束；说话停顿多时调大
HOMEPILOT_VAD_MIN_SILENCE_MS=700
# 单个语音片段最长秒数，超过后强制结束
HOMEPILOT_VAD_MAX_SPEECH_S=30
# 预缓冲时长（毫秒，200~1000），需覆盖 VAD 开始检测延迟（约 MIN_SPEECH_MS + 60ms）
HOMEPILOT_PREROLL_MS=500

# 唤醒后或追问时，多少秒没人说话就结束会话、回到等待唤醒
HOMEPILOT_SILENCE_TIMEOUT_S=15
# 说完后多少秒内没有收到回复就取消本轮
HOMEPILOT_RESPONSE_TIMEOUT_S=20
# 回复播放完后再等多少毫秒才开始听（让音箱余音消散，避免被当成用户说话）
HOMEPILOT_PLAYBACK_TAIL_MS=300
# 唤醒时播放「叮」提示音：true / false
HOMEPILOT_WAKE_SOUND=true
# 日志级别：DEBUG / INFO / WARNING / ERROR
HOMEPILOT_LOG_LEVEL=INFO
